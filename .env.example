# Legal contact shown on /impressum and /datenschutz.
# Copy to `.env.local` (git-ignored) for local dev. For deploys, set the same
# keys in Cloudflare Pages → Settings → Variables and Secrets (Production and
# Preview). A production build fails if any is missing.
VITE_LEGAL_NAME=
VITE_LEGAL_EMAIL=
# Address lines separated by "|". Keep the quotes here, because # would
# otherwise start a comment. No quotes in the Cloudflare field.
VITE_LEGAL_ADDRESS="c/o Service #00000|Street 1|00000 City"
